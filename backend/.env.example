# MongoDB Atlas connection string
MONGO_URL="mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
DB_NAME="ink_and_blade_studio"

# Generate a long random secret. Never commit the real value.
JWT_SECRET="replace-with-a-long-random-secret"

# Admin login for the studio dashboard
ADMIN_EMAIL="your-admin-email@example.com"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"

# Optional artist login. Leave ARTIST_PASSWORD empty if you do not need it.
ARTIST_EMAIL="marcus@inkandblade.com"
ARTIST_PASSWORD=""

# Stripe production credentials
STRIPE_SECRET_KEY="sk_live_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_MODE="live"

# Public frontend URL, e.g. https://ink-blade-web.onrender.com
FRONTEND_URL="https://YOUR-FRONTEND.onrender.com"
CORS_ORIGINS="https://YOUR-FRONTEND.onrender.com"
